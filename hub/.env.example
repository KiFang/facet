# Первый администратор хаба (кабинет вуза: /hub/admin). Остальных он добавит в кабинете.
HUB_ADMIN_EMAIL=it@univer.ru
HUB_ADMIN_PASSWORD=замените-на-длинный-пароль

# Домен хаба (A-запись на IP сервера) и HTTPS через Caddy.
DOMAIN=clubs.univer.ru
COMPOSE_PROFILES=https
HUB_PUBLIC_URL=https://clubs.univer.ru

# Без HTTPS-шлюза: открыть порт наружу (HUB_BIND=0.0.0.0) — только во внутренней сети.
HUB_BIND=127.0.0.1
HUB_PORT=8080
